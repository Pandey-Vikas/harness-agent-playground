{
  "name": "harness-agent-playground",
  "version": "0.1.0",
  "description": "Harness Agent Playground for Microsoft Foundry — six-step setup wizard + scenario runner.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch --env-file-if-exists=.env src/server.js",
    "wizard": "node --disable-warning=ExperimentalWarning scripts/setup-server.js"
  }
}
