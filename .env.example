# The mock provider works without any endpoint or credentials.
MODEL_PROVIDER=mock
PORT=3000

# ---- Foundry — Entra ID auth only ----
# Easiest way to fill in the block below is the built-in setup wizard:
#   .\start.ps1 -Setup
#
# MODEL_PROVIDER=foundry
# AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com
# AZURE_OPENAI_API_VERSION=2024-10-21
#
# AZURE_FOUNDRY_RESOURCE_NAME=YOUR-RESOURCE
# AZURE_FOUNDRY_RESOURCE_GROUP=YOUR-RESOURCE-GROUP
#
# Authentication is Microsoft Entra ID via the Azure CLI:
#   az login
# Signed-in user needs Cognitive Services User + Cognitive Services OpenAI User
# on the resource (the setup wizard grants both automatically).
